<?xml version="1.0" encoding="utf-8"?>
<!--
  4×2 三站小部件（v1.0.25 HyperOS 规范版）

  规范要点见 widget_small.xml 顶部注释（根 id / 安全区 / 深色静态适配 / 双 TextView 紧急态）。

  行结构：[4dp 线路色条] 站名(14sp) + 线路·方向(11sp) │ 倒计时(18sp) + 时刻(11sp)
  行高用 height=0dp + weight=1 均分，行间 1dp 分割线（不足一页时运行时 GONE）。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:paddingStart="10dp"
    android:paddingEnd="4dp">

    <LinearLayout
        android:id="@+id/widget_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingEnd="30dp">

        <LinearLayout
            android:id="@+id/row1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/row1_bar"
                android:layout_width="4dp"
                android:layout_height="18dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/row1_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="西二旗"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/row1_line"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="13号线 · 开往 西土城"
                    android:textColor="@color/widget_text_tertiary"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="end"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/row1_cd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="3 分钟"
                        android:textColor="@color/widget_accent"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/row1_cd_d"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="1 分钟"
                        android:textColor="@color/widget_danger"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <TextView
                    android:id="@+id/row1_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="14:32"
                    android:textColor="@color/widget_text_tertiary"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/div1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/widget_divider" />

        <LinearLayout
            android:id="@+id/row2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/row2_bar"
                android:layout_width="4dp"
                android:layout_height="18dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/row2_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="国贸"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/row2_line"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="10号线 · 内环"
                    android:textColor="@color/widget_text_tertiary"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="end"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/row2_cd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="6 分钟"
                        android:textColor="@color/widget_accent"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/row2_cd_d"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="1 分钟"
                        android:textColor="@color/widget_danger"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <TextView
                    android:id="@+id/row2_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="14:35"
                    android:textColor="@color/widget_text_tertiary"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/div2"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/widget_divider" />

        <LinearLayout
            android:id="@+id/row3"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/row3_bar"
                android:layout_width="4dp"
                android:layout_height="18dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/row3_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="西直门"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/row3_line"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="2号线 · 内环"
                    android:textColor="@color/widget_text_tertiary"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="end"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/row3_cd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="9 分钟"
                        android:textColor="@color/widget_accent"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/row3_cd_d"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="1 分钟"
                        android:textColor="@color/widget_danger"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <TextView
                    android:id="@+id/row3_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="14:38"
                    android:textColor="@color/widget_text_tertiary"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pager_box"
        android:layout_width="26dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/w_refresh"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@string/widget_refresh"
            android:scaleType="center"
            android:src="@drawable/ic_refresh" />

        <ImageView
            android:id="@+id/pager_prev"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@string/widget_prev_page"
            android:scaleType="center"
            android:src="@drawable/ic_chevron_up" />

        <TextView
            android:id="@+id/pager_num"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="1/3"
            android:textColor="@color/widget_text_tertiary"
            android:textSize="10sp" />

        <ImageView
            android:id="@+id/pager_next"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@string/widget_next_page"
            android:scaleType="center"
            android:src="@drawable/ic_chevron_down" />
    </LinearLayout>
</FrameLayout>
