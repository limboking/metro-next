<?xml version="1.0" encoding="utf-8"?>
<!--
  4×2 三站小部件（v1.0.32 排版定稿）

  规范要点见 widget_small.xml 顶部注释（根 id / 安全区 / 深色静态适配 / 双 TextView 紧急态）。

  行结构：[4dp 线路色条] 站名(13sp 粗) + 线路·方向(10sp) │ 倒计时(17sp) + 时刻(10sp)
  行数恒等于 perPage（4×2=3 / 4×4=6），行高 height=0dp + weight=1 均分。
  v1.0.32：收藏不足一页时**空行不再 GONE、保留占位**（清空文本、隐藏色条）——
  于是每行恒占「卡高 ÷ perPage」一格，内容贴顶、留白集中在底部，行距不随收藏多少变化；
  满页时与旧版完全一致（零感知）。旧版把空行 GONE 掉，剩下的行把整卡高度均分，
  收藏少时行距被拉开（朋友机 4×4 只收藏 4 站 → 行间大片留白）。
  长文案（站名 / 线路·方向）由 MetroWidget 的 TextFit 按实测可用宽处理：一行放得下就用一行，
  放不下且含「开往」则断在「开往」后换两行（v1.0.32：列表同样允许两行——否则遇到
  「X 小时 Y 分」这类宽倒计时把左列挤窄时，长线路名只能截断，而截断是用户明确不能接受的）；
  连断行都放不下才降字号。此处 textSize 只是预览/兜底值。
  行间 1dp 分割线：本行或下一行无内容时运行时隐藏。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:paddingStart="10dp"
    android:paddingEnd="4dp">

    <LinearLayout
        android:id="@+id/widget_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingEnd="30dp">

        <LinearLayout
            android:id="@+id/row1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/row1_bar"
                android:layout_width="4dp"
                android:layout_height="18dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/row1_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="西二旗"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/row1_line"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:text="13号线 · 开往 西土城"
                    android:textColor="@color/widget_text_tertiary"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="end"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/row1_cd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="3 分钟"
                        android:textColor="@color/widget_accent"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/row1_cd_d"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="1 分钟"
                        android:textColor="@color/widget_danger"
                        android:visibility="gone"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <TextView
                    android:id="@+id/row1_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="14:32"
                    android:textColor="@color/widget_text_tertiary"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/div1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/widget_divider" />

        <LinearLayout
            android:id="@+id/row2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/row2_bar"
                android:layout_width="4dp"
                android:layout_height="18dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/row2_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="国贸"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/row2_line"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:text="10号线 · 内环"
                    android:textColor="@color/widget_text_tertiary"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="end"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/row2_cd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="6 分钟"
                        android:textColor="@color/widget_accent"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/row2_cd_d"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="1 分钟"
                        android:textColor="@color/widget_danger"
                        android:visibility="gone"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <TextView
                    android:id="@+id/row2_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="14:35"
                    android:textColor="@color/widget_text_tertiary"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/div2"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/widget_divider" />

        <LinearLayout
            android:id="@+id/row3"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/row3_bar"
                android:layout_width="4dp"
                android:layout_height="18dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/row3_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="西直门"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/row3_line"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:text="2号线 · 内环"
                    android:textColor="@color/widget_text_tertiary"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="end"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/row3_cd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="9 分钟"
                        android:textColor="@color/widget_accent"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/row3_cd_d"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="1 分钟"
                        android:textColor="@color/widget_danger"
                        android:visibility="gone"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <TextView
                    android:id="@+id/row3_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="14:38"
                    android:textColor="@color/widget_text_tertiary"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pager_box"
        android:layout_width="26dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/w_refresh"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@string/widget_refresh"
            android:scaleType="center"
            android:src="@drawable/ic_refresh" />

        <ImageView
            android:id="@+id/pager_prev"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@string/widget_prev_page"
            android:scaleType="center"
            android:src="@drawable/ic_chevron_up" />

        <TextView
            android:id="@+id/pager_num"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="1/3"
            android:textColor="@color/widget_text_tertiary"
            android:textSize="10sp" />

        <ImageView
            android:id="@+id/pager_next"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@string/widget_next_page"
            android:scaleType="center"
            android:src="@drawable/ic_chevron_down" />
    </LinearLayout>
</FrameLayout>
