        android:layout_width="26dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:gravity="center"
        android:orientation="vertical">

        <!-- v1.0.17：手动刷新按钮（翻页按钮上方空白处）。
             常显——即使只有一页（翻页控件隐藏时刷新仍可用）。 -->
