<?xml version="1.0" encoding="utf-8"?>
<!-- v1.0.8：色条改为 TextView + setBackgroundColor（弃用位图，修复小米翻页后色条消失）。
     其余同 v1.0.7：FrameLayout 根、翻页列钉右缘、行 weight 均分。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
